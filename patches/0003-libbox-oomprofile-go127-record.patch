--- /dev/null
+++ b/experimental/libbox/internal/oomprofile/memrecord_go127.go
@@ -0,0 +1,15 @@
+//go:build (darwin || linux || windows) && go1.27
+
+package oomprofile
+
+// Mirrors internal/profilerecord.MemProfileRecord, which Go 1.27 reshaped to
+// one ObjectSize; pprof_memProfileInternal fills this layout byte for byte.
+type memProfileRecord struct {
+	ObjectSize                int64
+	AllocObjects, FreeObjects int64
+	Stack                     []uintptr
+}
+
+func (r *memProfileRecord) AllocBytes() int64   { return r.AllocObjects * r.ObjectSize }
+func (r *memProfileRecord) InUseBytes() int64   { return r.InUseObjects() * r.ObjectSize }
+func (r *memProfileRecord) InUseObjects() int64 { return r.AllocObjects - r.FreeObjects }
