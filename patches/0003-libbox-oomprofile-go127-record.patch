diff --git a/experimental/libbox/internal/oomprofile/oomprofile_test.go b/experimental/libbox/internal/oomprofile/oomprofile_test.go
new file mode 100644
index 0000000..0c058c4
--- /dev/null
+++ b/experimental/libbox/internal/oomprofile/oomprofile_test.go
@@ -0,0 +1,43 @@
+//go:build darwin || linux || windows
+
+package oomprofile
+
+import (
+	"bytes"
+	"runtime"
+	"testing"
+)
+
+var sink [][]byte
+
+// The memory-pressure callback writes this profile; a record layout that does
+// not match the runtime's reads garbage stacks and crashes the extension.
+func TestWriteAllocMatchesRuntimeRecords(t *testing.T) {
+	old := runtime.MemProfileRate
+	runtime.MemProfileRate = 1
+	t.Cleanup(func() { runtime.MemProfileRate = old })
+	for i := 0; i < 1000; i++ {
+		sink = append(sink, make([]byte, 4096))
+	}
+	runtime.GC()
+
+	n, _ := runtimeMemProfileInternal(nil, true)
+	records := make([]memProfileRecord, n+50)
+	n, ok := runtimeMemProfileInternal(records, true)
+	if !ok || n == 0 {
+		t.Fatalf("runtime returned %d records, ok=%v", n, ok)
+	}
+	for _, record := range records[:n] {
+		if record.InUseObjects() < 0 || len(record.Stack) == 0 || len(record.Stack) > 1024 {
+			t.Fatalf("record read with the wrong layout: objects %d, stack of %d", record.InUseObjects(), len(record.Stack))
+		}
+	}
+
+	var out bytes.Buffer
+	if err := writeAlloc(&out); err != nil {
+		t.Fatal(err)
+	}
+	if out.Len() == 0 {
+		t.Fatal("empty allocs profile")
+	}
+}
