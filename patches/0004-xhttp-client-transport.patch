+package v2rayxhttp
+
+import (
+	"io"
+	"net"
+	"os"
+	"sync"
+	"time"
+
+	"github.com/sagernet/sing/common"
+	"github.com/sagernet/sing/common/baderror"
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+var _ net.Conn = (*streamConn)(nil)
+
+// streamConn joins the uplink pipe with a downlink body that arrives later.
+type streamConn struct {
+	writer    *io.PipeWriter
+	reader    io.ReadCloser
+	ready     chan struct{}
+	readyOnce sync.Once
+	err       error
+}
+
+func newStreamConn(writer *io.PipeWriter) *streamConn {
+	return &streamConn{writer: writer, ready: make(chan struct{})}
+}
+
+func (c *streamConn) setup(reader io.ReadCloser, err error) {
+	c.readyOnce.Do(func() {
+		c.reader = reader
+		c.err = err
+		close(c.ready)
+	})
+	if reader != nil && c.reader != reader {
+		reader.Close()
+	}
+}
+
+// closeWithError also ends a downlink that is already open, so Read does not wait for the server.
+func (c *streamConn) closeWithError(err error) {
+	c.setup(nil, err)
+	c.writer.CloseWithError(err)
+	if c.reader != nil {
+		c.reader.Close()
+	}
+}
+
+func (c *streamConn) Read(b []byte) (int, error) {
+	<-c.ready
+	if c.reader == nil {
+		return 0, c.err
+	}
+	n, err := c.reader.Read(b)
+	return n, baderror.WrapH2(err)
+}
+
+func (c *streamConn) Write(b []byte) (int, error) {
+	n, err := c.writer.Write(b)
+	return n, baderror.WrapH2(err)
+}
+
+func (c *streamConn) Close() error {
+	c.setup(nil, net.ErrClosed)
+	return common.Close(c.writer, c.reader)
+}
+
+func (c *streamConn) LocalAddr() net.Addr {
+	return M.Socksaddr{}
+}
+
+func (c *streamConn) RemoteAddr() net.Addr {
+	return M.Socksaddr{}
+}
+
+func (c *streamConn) SetDeadline(t time.Time) error {
+	return os.ErrInvalid
+}
+
+func (c *streamConn) SetReadDeadline(t time.Time) error {
+	return os.ErrInvalid
+}
+
+func (c *streamConn) SetWriteDeadline(t time.Time) error {
+	return os.ErrInvalid
+}
+
+func (c *streamConn) NeedAdditionalReadDeadline() bool {
+	return true
+}
